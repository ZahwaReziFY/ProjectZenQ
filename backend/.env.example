PORT=3000

# URL frontend yang boleh akses API ini (buat CORS)
FRONTEND_URL=http://localhost:5173

# Koneksi PostgreSQL - ganti PASSWORD_KAMU
DATABASE_URL=postgres://postgres:PASSWORD_KAMU@localhost:5432/zenq

# JWT
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
JWT_EXPIRES_IN=1d

# ---------- API pihak ketiga (semua opsional) ----------

# Data obat BPOM via API Indonesia (https://apiindonesia.id/en/produk/bpom/)
# Bikin API key gratis di dashboard-nya. Kosong = scan obat cuma pake DB lokal.
BPOM_API_URL=https://use.apiindonesia.id/api/v1/bpom
BPOM_API_KEY=

# Berita kesehatan (api-berita-indonesia). Kalo jalanin repo-nya sendiri, ganti URL-nya.
NEWS_API_BASE=https://api-berita-indonesia.vercel.app

# Faskes terdekat dari OpenStreetMap. Kosongin buat pake data demo lokal aja.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Gemini AI (opsional) - dipakai CHATBOT dan SCAN OBAT (OCR foto kemasan).
# Kosong = chatbot rule-based bawaan + scan obat pakai tesseract.js di browser.
# Ambil key di https://aistudio.google.com/apikey
AI_API_KEY=
AI_MODEL=gemini-3.7-flash
# Cek key & model sudah benar:  npm run cek-ai

# Batas ukuran upload foto obat (MB)
MAX_UPLOAD_MB=5
